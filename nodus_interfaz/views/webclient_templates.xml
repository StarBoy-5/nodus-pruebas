<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Favicon de Nodus en todas las páginas -->
    <template id="layout_favicon" inherit_id="web.layout" name="Nodus: favicon">
        <xpath expr="//link[@rel='shortcut icon']" position="attributes">
            <attribute name="t-att-href">x_icon or '/nodus_interfaz/static/src/img/favicon.png'</attribute>
        </xpath>
    </template>

    <!-- Pantalla de inicio de sesión: Nodus en vez de "Powered by Odoo" -->
    <template id="login_layout_nodus" inherit_id="web.login_layout" name="Nodus: inicio de sesión">
        <xpath expr="//a[@href='https://www.odoo.com?utm_source=db&amp;utm_medium=auth']" position="replace">
            <span class="o_nodus_powered">Nodus</span>
        </xpath>
    </template>

    <!-- "Powered by Odoo" del portal y los correos -->
    <template id="brand_promotion_message_nodus" inherit_id="web.brand_promotion_message" name="Nodus: marca">
        <xpath expr="//t[@t-set='final_message']" position="replace">
            <t t-set="final_message">%s%s</t>
        </xpath>
        <xpath expr="//t[@t-set='odoo_logo']" position="replace">
            <t t-set="odoo_logo">Nodus</t>
        </xpath>
    </template>
</odoo>
