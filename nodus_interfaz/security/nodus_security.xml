<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_nodus" model="ir.module.category">
        <field name="name">Nodus</field>
        <field name="sequence">1</field>
    </record>

    <!-- Cuenta de soporte de Nodus: ve todo, incluidas las apps que el cliente no ve -->
    <record id="group_nodus_soporte" model="res.groups">
        <field name="name">Soporte Nodus</field>
        <field name="comment">Acceso de soporte de Nodus: ve todas las aplicaciones de Odoo.</field>
        <!-- El administrador y OdooBot son de soporte (base.user_admin no se puede editar desde aquí: es noupdate) -->
        <field name="user_ids" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
    </record>

    <!-- Roles del cliente (los de la pantalla Configuración): cada uno trae los permisos de Odoo que necesita -->
    <record id="group_nodus_cajero" model="res.groups">
        <field name="name">Nodus: Cajero</field>
        <field name="comment">Cobro y emisión de tickets en el Punto de Venta.</field>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user')), (4, ref('base.group_partner_manager'))]"/>
    </record>
    <record id="group_nodus_mesero" model="res.groups">
        <field name="name">Nodus: Mesero</field>
        <field name="comment">Abre mesas, toma pedidos y manda comandas. No cobra ni da descuentos.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('point_of_sale.group_pos_user'))]"/>
    </record>
    <record id="group_nodus_supervisor" model="res.groups">
        <field name="name">Nodus: Supervisor</field>
        <field name="comment">Todo lo de Cajero, más inventario, compras y catálogo de productos.</field>
        <field name="implied_ids" eval="[(4, ref('group_nodus_cajero')), (4, ref('stock.group_stock_manager')), (4, ref('purchase.group_purchase_user'))]"/>
    </record>
    <record id="group_nodus_contador" model="res.groups">
        <field name="name">Nodus: Contador</field>
        <field name="comment">Facturas y contabilidad. Es independiente de Supervisor.</field>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user')), (4, ref('base.group_partner_manager'))]"/>
    </record>
    <record id="group_nodus_admin" model="res.groups">
        <field name="name">Nodus: Administrador de la empresa</field>
        <field name="comment">Acceso completo: Cajero + Supervisor + Contador, más Configuración y usuarios.</field>
        <field name="implied_ids" eval="[(4, ref('group_nodus_supervisor')), (4, ref('group_nodus_contador')), (4, ref('account.group_account_manager')), (4, ref('point_of_sale.group_pos_manager'))]"/>
    </record>

</odoo>
