<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Nombre de la app instalada (manifiesto PWA) -->
    <record id="param_web_app_name" model="ir.config_parameter" forcecreate="1">
        <field name="key">web.web_app_name</field>
        <field name="value">Nodus</field>
    </record>

    <!-- Sin registro libre: las cuentas las crea el administrador ("¿No tienes una cuenta?").
         set_param porque el parámetro ya existe cuando auth_signup está instalado. -->
    <function model="ir.config_parameter" name="set_param" eval="('auth_signup.invitation_scope', 'b2b')"/>

    <!-- Menú Principal: es la primera app, así que Odoo lo abre al entrar -->
    <record id="action_menu_principal" model="ir.actions.client">
        <field name="name">Menú Principal</field>
        <field name="tag">nodus_menu_principal</field>
        <field name="path">menu-principal</field>
    </record>

    <menuitem id="menu_principal"
              name="Menú Principal"
              action="action_menu_principal"
              web_icon="nodus_interfaz,static/description/icon.png"
              sequence="-100"/>

    <!-- Resumen (la pantalla "Ventas" de hadeon_ui): tablero del negocio y, como secciones, los documentos de Odoo detrás -->
    <record id="action_tablero_ventas" model="ir.actions.client">
        <field name="name">Resumen</field>
        <field name="tag">nodus_tablero_ventas</field>
        <field name="path">resumen</field>
    </record>

    <menuitem id="menu_ventas"
              name="Resumen"
              web_icon="nodus_interfaz,static/description/icon.png"
              sequence="-90">
        <menuitem id="menu_ventas_tablero" name="Tablero" action="action_tablero_ventas" sequence="1"/>
        <menuitem id="menu_ventas_ordenes" name="Órdenes del POS" action="point_of_sale.action_pos_pos_form"
                  groups="point_of_sale.group_pos_user" sequence="10"/>
        <menuitem id="menu_ventas_facturas" name="Facturas" action="account.action_move_out_invoice_type"
                  groups="account.group_account_invoice" sequence="20"/>
    </menuitem>

    <!-- Menús de otros módulos que en Nodus van dentro de otra app (Precios dentro de Inventario) -->
    <function model="ir.ui.menu" name="_nodus_reubicar_menus"/>
</odoo>
