<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Nombre de la app instalada (manifiesto PWA) -->
    <record id="param_web_app_name" model="ir.config_parameter" forcecreate="1">
        <field name="key">web.web_app_name</field>
        <field name="value">Nodus</field>
    </record>

    <!-- Sin registro libre: las cuentas las crea el administrador ("¿No tienes una cuenta?").
         set_param porque el parámetro ya existe cuando auth_signup está instalado. -->
    <function model="ir.config_parameter" name="set_param" eval="('auth_signup.invitation_scope', 'b2b')"/>

    <!-- Menú Principal: es la primera app, así que Odoo lo abre al entrar -->
    <record id="action_menu_principal" model="ir.actions.client">
        <field name="name">Menú Principal</field>
        <field name="tag">nodus_menu_principal</field>
        <field name="path">menu-principal</field>
    </record>

    <menuitem id="menu_principal"
              name="Menú Principal"
              action="action_menu_principal"
              web_icon="nodus_interfaz,static/description/icon.png"
              sequence="-100"/>

    <!-- Resumen (la pantalla "Ventas" de hadeon_ui): tablero del negocio y, como secciones, los documentos de Odoo detrás -->
    <record id="action_tablero_ventas" model="ir.actions.client">
        <field name="name">Resumen</field>
        <field name="tag">nodus_tablero_ventas</field>
        <field name="path">resumen</field>
    </record>

    <menuitem id="menu_ventas"
              name="Resumen"
              web_icon="nodus_interfaz,static/description/icon.png"
              sequence="-90">
        <menuitem id="menu_ventas_tablero" name="Tablero" action="action_tablero_ventas" sequence="1"/>
        <menuitem id="menu_ventas_ordenes" name="Órdenes del POS" action="point_of_sale.action_pos_pos_form"
                  groups="point_of_sale.group_pos_user" sequence="10"/>
        <menuitem id="menu_ventas_facturas" name="Facturas" action="account.action_move_out_invoice_type"
                  groups="account.group_account_invoice" sequence="20"/>
    </menuitem>

    <!-- Pantallas diseñadas en hadeon_ui: son la primera opción de su app, así que se abren al entrar -->
    <record id="action_ui_inventario" model="ir.actions.client">
        <field name="name">Inventario</field>
        <field name="tag">nodus_inventario</field>
        <field name="path">inventario</field>
    </record>
    <menuitem id="menu_ui_inventario" name="Inventario" parent="stock.menu_stock_root"
              action="action_ui_inventario" sequence="-1"/>

    <record id="action_ui_contactos" model="ir.actions.client">
        <field name="name">Contactos</field>
        <field name="tag">nodus_contactos</field>
        <field name="path">contactos</field>
    </record>
    <menuitem id="menu_ui_contactos" name="Contactos" parent="contacts.menu_contacts"
              action="action_ui_contactos" sequence="-1"/>

    <record id="action_ui_contabilidad" model="ir.actions.client">
        <field name="name">Contabilidad</field>
        <field name="tag">nodus_contabilidad</field>
        <field name="path">contabilidad</field>
    </record>
    <menuitem id="menu_ui_contabilidad" name="Contabilidad" parent="account.menu_finance"
              action="action_ui_contabilidad" sequence="-1"/>

    <record id="action_ui_pos" model="ir.actions.client">
        <field name="name">Punto de Venta</field>
        <field name="tag">nodus_pagina_ui</field>
        <field name="params" eval="{'pagina': 'punto-de-venta'}"/>
        <field name="path">punto-de-venta</field>
    </record>
    <menuitem id="menu_ui_pos" name="Punto de Venta" parent="point_of_sale.menu_point_root"
              action="action_ui_pos" sequence="-1"/>

    <!-- Comandas: lo que el Punto de Venta manda a cocina, barra, parrilla... -->
    <record id="seq_nodus_comanda" model="ir.sequence">
        <field name="name">Comandas Nodus</field>
        <field name="code">nodus.comanda</field>
        <field name="prefix">#</field>
        <field name="padding">4</field>
    </record>
    <record id="action_ui_comandas" model="ir.actions.client">
        <field name="name">Comandas</field>
        <field name="tag">nodus_comandas</field>
        <field name="path">comandas</field>
    </record>
    <menuitem id="menu_comandas" name="Comandas" action="action_ui_comandas"
              web_icon="nodus_interfaz,static/description/icon.png" sequence="950"/>

    <!-- Configuración: lo que ve el cliente. Los Ajustes originales de Odoo quedan solo para soporte -->
    <record id="action_ui_configuracion" model="ir.actions.client">
        <field name="name">Configuración</field>
        <field name="tag">nodus_configuracion</field>
        <field name="path">configuracion</field>
    </record>
    <menuitem id="menu_configuracion" name="Configuración" action="action_ui_configuracion"
              web_icon="nodus_interfaz,static/description/icon.png" sequence="900"
              groups="nodus_interfaz.group_nodus_admin,nodus_interfaz.group_nodus_soporte"/>

    <!-- El asistente automático de Odoo se llama Nodus Bot -->
    <function model="res.partner" name="write">
        <value eval="[ref('base.partner_root')]"/>
        <value eval="{'name': 'Nodus Bot'}"/>
    </function>

    <!-- Menús de otros módulos que en Nodus van dentro de otra app (Precios dentro de Inventario) -->
    <function model="ir.ui.menu" name="_nodus_reubicar_menus"/>
</odoo>
