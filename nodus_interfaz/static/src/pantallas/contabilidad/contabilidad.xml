<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="nodus_interfaz.Contabilidad">
        <div class="o_action nd-pant nd-contabilidad" t-ref="raiz">
            <div class="nd-pant-cuerpo">
                <div class="nd-conta-cab">
<header class="nd-pant-cab">
                    <h1 class="nd-pant-titulo">Contabilidad</h1>
                    <p class="nd-pant-sub">Consulta y gestión de movimientos contables detallados</p>
                </header>
<div class="botones-wrapper">
  <!-- Botones Adaptables -->
  <div id="conta-botones-superiores-app">
    <button class="conta-btn-superior" data-vista="asientos-contables">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
      Asientos contables
    </button>
    <button class="conta-btn-superior" data-vista="balance-comprobacion">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
      Balance de comprobación
    </button>
    <button class="conta-btn-superior" data-vista="libro-diario">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      Libro diario
    </button>
  </div>
</div>
</div>
                <div class="nd-pant-app">
<!-- Envoltura Fantasma -->




<div id="conta-filtros-app">

  <!-- FILA 1: BUSCADOR + EXPORTAR + FILTRO DE FECHA -->
  <div class="conta-fila-superior">
    <div class="conta-buscador-wrapper">
      <svg class="conta-buscador-icono" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/></svg>
      <input type="text" id="conta-buscador" class="conta-buscador-input" placeholder="Buscar"/>
    </div>

    <div class="conta-fila-superior-derecha">
      <button class="conta-btn-exportar" id="conta-btn-moneda" type="button"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg> Ver en Bs.</button>
      <button class="conta-btn-exportar" id="conta-btn-exportar">
        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 11 11" fill="none"><path d="M5.33333 8L2 4.66667L2.93333 3.7L4.66667 5.43333V0H6V5.43333L7.73333 3.7L8.66667 4.66667L5.33333 8ZM1.33333 10.6667C0.966667 10.6667 0.652778 10.5361 0.391667 10.275C0.130556 10.0139 0 9.7 0 9.33333V7.33333H1.33333V9.33333H9.33333V7.33333H10.6667V9.33333C10.6667 9.7 10.5361 10.0139 10.275 10.275C10.0139 10.5361 9.7 10.6667 9.33333 10.6667H1.33333Z" fill="currentColor"/></svg>
        Exportar
      </button>

      <div class="conta-filtro-fecha" id="conta-filtro-fecha">
        <button data-periodo="dia" id="btn-periodo-dia">Día</button>
        <button class="activo" data-periodo="mes" id="btn-periodo-mes">Mes</button>
        <button data-periodo="año" id="btn-periodo-año">Año</button>
        <div class="conta-fecha-popover" id="conta-fecha-popover"/>
      </div>

    </div>
  </div>

  <!-- FILA 2: PESTAÑAS -->
  <div class="conta-fila-inferior">
    <div class="conta-tabs-wrapper">
      <button id="conta-tabs-scroll-izq" class="conta-tabs-flecha" type="button" aria-label="Desplazar izquierda">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <div class="conta-tabs" id="conta-tabs">
        <button class="conta-tab-btn activo" data-vista="libro-mayor">Libro mayor</button>
        <button class="conta-tab-btn" data-vista="cuentas-cobrar">Cuentas por cobrar</button>
        <button class="conta-tab-btn" data-vista="cuentas-pagar">Cuentas por pagar</button>
        <button class="conta-tab-btn" data-vista="balance-general">Balance general</button>
        <button class="conta-tab-btn" data-vista="estado-resultados">Ganancias y pérdidas</button>
      </div>
      <button id="conta-tabs-scroll-der" class="conta-tabs-flecha" type="button" aria-label="Desplazar derecha">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </div>

</div>



<div id="conta-kpis-contenedor"/>



<div id="contabilidad-vistas-app">
  <div class="conta-panel">
    <div class="conta-vista activa" id="vista-libro-mayor" data-titulo="Libro mayor"/>
    <div class="conta-vista" id="vista-cuentas-cobrar" data-titulo="Cuentas por cobrar"/>
    <div class="conta-vista" id="vista-cuentas-pagar" data-titulo="Cuentas por pagar"/>
    <div class="conta-vista" id="vista-balance-general" data-titulo="Balance general"/>
    <div class="conta-vista" id="vista-estado-resultados" data-titulo="Ganancias y pérdidas"/>
    <div class="conta-vista" id="vista-asientos-contables" data-titulo="Asientos contables"/>
    <div class="conta-vista" id="vista-balance-comprobacion" data-titulo="Balance de comprobación"/>
    <div class="conta-vista" id="vista-libro-diario" data-titulo="Libro diario"/>
  </div>
</div>
                </div>
            </div>
        </div>
    </t>
</templates>
